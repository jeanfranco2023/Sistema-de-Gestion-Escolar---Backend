# ===================================================================
# Shuji Kitamura - Sistema de Gestión Escolar (Backend)
# Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' y completa con tus credenciales
# ===================================================================

# Configuración del Servidor
SERVER_PORT=8080

# Base de Datos PostgreSQL (Supabase / Local)
SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=tu_password_aqui
SUPABASE_DB_SSLMODE=prefer

# HikariCP Pool de Conexiones
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_IDLE_TIMEOUT=300000
HIKARI_MAX_LIFETIME=600000

# Seguridad JWT (HMAC-SHA256 - mínimo 256 bits en Base64)
JWT_SECRET=c2h1amlfa2l0YW11cmFfcHJveWVjdG9faW50ZWdyYWRvcl91dHBfMjAyNg==
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Consulta de DNI a API Perú. La API Key se envía como Bearer; no se envían dos credenciales.
DNI_API_URL=https://api.apiperu.pe/dni
DNI_API_KEY=
# Compatibilidad con proveedores previos que usan Bearer token.
DNI_API_TOKEN=

# Validación documental de matrícula pública (solo backend; nunca configurar en Angular)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Pasarela de Pagos: Mercado Pago (Checkout Pro y Webhooks IPN)
MERCADOPAGO_PUBLIC_KEY=APP_USR-86474939-d202-45ae-a7f3-eaeeb7b5606a
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_URL=https://api.mercadopago.com
# Hosts HTTPS exactos, separados por coma, autorizados para success/failure/pending.
MERCADOPAGO_RETURN_URL_HOSTS=localhost

# Integraciones Pasarelas Adicionales (Culqi / Niubiz)
PAGOS_VERIFICADOR_URL=
PAGOS_API_TOKEN=
PAGOS_WEBHOOK_SECRET=

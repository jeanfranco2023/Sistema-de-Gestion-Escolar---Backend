// AGRUPACIÓN VISUAL POR MÓDULO.

TableGroup UsuariosYSeguridad {
  roles
  usuarios
  usuario_roles
  sesiones
  auditoria_cambios
}

TableGroup OrganizacionAcademica {
  anios_lectivos
  niveles
  grados
  aulas
  periodos_academicos
  secciones
  bloques_horarios
  horarios_seccion
}

TableGroup CurriculoYDocencia {
  areas_curriculares
  competencias
  asignaciones_docentes
}

TableGroup MatriculaYFamilia {
  versiones_documentos_matricula
  estudiantes
  apoderados
  estudiante_apoderados
  matriculas
  solicitudes_matricula_publica
  solicitudes_matricula_documentos
}

TableGroup EvaluacionYRefuerzo {
  calificaciones_cneb
  sesiones_refuerzo
  inscripciones_refuerzo
}

TableGroup Asistencia {
  lotes_biometrico
  marcas_biometrico_porteria
  asistencias_aula
  conciliaciones_asistencia
}

TableGroup Comunicacion {
  comunicados_oficiales
  comunicado_destinatarios
}

TableGroup Convivencia {
  incidencias_conductuales
}

TableGroup Tesoreria {
  conceptos_cobro
  obligaciones_pago
  pagos_transacciones
  series_comprobante
  comprobantes_pago
}

// Verificaciones automáticas de documentos — V20
Table versiones_documentos_matricula {
  id uuid [pk, not null]
  solicitud_id uuid [not null]
  tipo varchar(30) [not null]
  contenedor varchar(100) [not null]
  ruta_objeto varchar(500) [not null]
  tipo_contenido varchar(30) [not null]
  tamano_bytes bigint [not null]
  huella_sha256 char(64) [not null]
  ia_valida boolean [null]
  dni_api_coincide boolean [null]
  vinculo_parental_coincide boolean [null]
  observacion_ia varchar(500) [null]
  estado_firma varchar(20) [not null]
  detalle_firma varchar(500) [not null]
  certificado_sha256 char(64) [null]
  fecha_carga timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (id, solicitud_id, tipo) [unique]
    (solicitud_id, tipo, fecha_carga) [name: 'idx_versiones_documentos_solicitud_tipo']
  }
  checks {
    `tipo IN ('PARTIDA_NACIMIENTO','DNI_C4','RECIBO_SERVICIO')`
    `tamano_bytes > 0 AND tamano_bytes <= 5242880`
    `estado_firma IN ('VALIDA','INVALIDA','NO_APLICA','NO_VERIFICABLE','ERROR_SERVICIO')`
    `huella_sha256 ~ '^[0-9a-f]{64}$'`
  }
}
Ref: solicitudes_matricula_publica.autorizado_por_usuario_id > usuarios.id
Ref: versiones_documentos_matricula.solicitud_id > solicitudes_matricula_publica.id
Ref: solicitudes_matricula_documentos.(version_id, solicitud_id, tipo) > versiones_documentos_matricula.(id, solicitud_id, tipo)
